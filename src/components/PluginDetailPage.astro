---
import type { Locale } from "../i18n";
import { detailMessages, pluginCategoryMessages } from "../i18n";
import Layout from "../layouts/Layout.astro";
import { loadPluginDetails, type PluginContribution } from "../lib/plugin-details";
import { loadMarketplaceRegistry } from "../lib/marketplace-registry";
import { pluginVisualVariant } from "../lib/plugin-registry";

interface Props {
  locale: Locale;
  pluginId?: string;
}

const { locale, pluginId = "" } = Astro.props;
const t = detailMessages[locale];
const categoryLabels = pluginCategoryMessages[locale];
const listPath = locale === "zh" ? "/zh/" : "/";

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=3600",
);

let plugin;
try {
  const registry = await loadMarketplaceRegistry();
  plugin = registry.plugins.find((entry) => entry.id === pluginId);
} catch (error) {
  console.error("Could not load the Eidos plugin registry", error);
}

const details = plugin ? await loadPluginDetails(plugin, locale) : undefined;
const manifest = details?.manifest;
const publisher = plugin?.repo.split("/")[0];
const repoUrl = plugin ? `https://github.com/${plugin.repo}` : "";
const releaseUrl = plugin
  ? `${repoUrl}/releases/tag/${encodeURIComponent(plugin.tag)}`
  : "";
const installUrl = plugin
  ? `eidos-lite://plugins/install/${encodeURIComponent(plugin.id)}`
  : "";
const iconVariant = plugin ? pluginVisualVariant(plugin.id) : 1;
const contributions = manifest
  ? [...manifest.views, ...manifest.actions, ...manifest.formatters]
  : [];

const contributionType = (item: PluginContribution) => {
  if (item.context === "table") return t.table;
  if (item.context === "document") return t.document;
  if (item.context === "page") return t.page;
  return t.contribution;
};
const isTheme = plugin?.kind === "theme";
const backUrl = isTheme
  ? locale === "zh"
    ? "/zh/themes"
    : "/themes"
  : locale === "zh"
    ? "/zh"
    : "/";
---

<Layout
  locale={locale}
  title={
    plugin
      ? `${plugin.name} · ${plugin.kind === "theme" ? (locale === "zh" ? "Eidos 主题" : "Eidos Themes") : (locale === "zh" ? "Eidos 插件" : "Eidos Plugins")}`
      : `${t.notFound} · Eidos`
  }
  description={plugin?.description ?? t.notFoundBody}
  currentSection={isTheme ? "themes" : "plugins"}
>
  {
    plugin ? (
      <main class="detail-page">
        <section class="detail-hero">
          <div class="shell">
            <a
              class="detail-back"
              href={backUrl}
              aria-label={isTheme ? t.backThemes : t.back}
            >
              <span aria-hidden="true">←</span>
              {isTheme ? t.backThemes : t.back}
            </a>

            <div class="detail-identity">
              <span class={`detail-icon plugin-icon-${iconVariant}`}>
                {plugin.icon ? (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {plugin.icon.paths.map((path) => <path d={path} />)}
                  </svg>
                ) : (
                  <span>{plugin.name.slice(0, 1)}</span>
                )}
              </span>

              <div class="detail-heading">
                <div class="detail-labels">
                  <span>{plugin.kind === "theme" ? t.themesMarketplace : t.marketplace}</span>
                  <span class="detail-category-label">{categoryLabels[plugin.category]}</span>
                </div>
                <h1>{plugin.name}</h1>
                <p class="detail-byline">{publisher} · <code>{plugin.id}</code> · v{plugin.version}</p>
              </div>

              <div class="detail-summary">
                <p class="detail-description">{plugin.description}</p>
                <div class="detail-actions">
                  <a class="detail-primary-action" href={installUrl}>{t.install}</a>
                  <a class="detail-secondary-action" href={repoUrl}>{t.source}<span aria-hidden="true">↗</span></a>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="shell detail-layout">
          <article class="detail-main">
            {!!plugin.screenshots?.length && (
              <section class="app-screenshots" aria-label={t.appProfile}>
                {plugin.screenshots.map((screenshot) => (
                  <figure>
                    <img
                      src={`https://raw.githubusercontent.com/${plugin.repo}/main/${screenshot.path}`}
                      alt={screenshot.alt}
                      loading="lazy"
                    />
                    <figcaption>{screenshot.alt}</figcaption>
                  </figure>
                ))}
              </section>
            )}

            <section class="detail-about" aria-labelledby="about-title">
              <h2 id="about-title">{plugin.kind === "theme" ? t.aboutTheme : t.about}</h2>
              {details?.readmeHtml ? (
                <div class="plugin-readme" set:html={details.readmeHtml} />
              ) : (
                <p class="detail-unavailable">{t.unavailable}</p>
              )}
            </section>
          </article>

          <aside class="detail-sidebar" id="properties">
            <section class="detail-panel">
              <h2>{t.properties}</h2>
              <dl>
                <div><dt>{t.identifier}</dt><dd><code>{plugin.id}</code></dd></div>
                <div><dt>{t.category}</dt><dd>{categoryLabels[plugin.category]}</dd></div>
                <div><dt>{t.version}</dt><dd>{plugin.version}</dd></div>
                <div><dt>{t.apiVersion}</dt><dd>{manifest?.requiresPluginApi ?? manifest?.apiVersion ?? "1.0"}</dd></div>
                <div><dt>{t.type}</dt><dd>{plugin.kind === "theme" ? t.theme : t.pluginType}</dd></div>
                <div><dt>{t.compatibility}</dt><dd>{plugin.compatibility}</dd></div>
              </dl>
            </section>

            {plugin.kind !== "theme" && (
              <section class="detail-panel">
                <h2>{t.capabilities}</h2>
                <dl>
                  <div><dt>{t.views}</dt><dd>{manifest?.views.length ?? 0}</dd></div>
                  <div><dt>{t.actions}</dt><dd>{manifest?.actions.length ?? 0}</dd></div>
                  <div><dt>{t.formatters}</dt><dd>{manifest?.formatters.length ?? 0}</dd></div>
                </dl>
                {contributions.length > 0 && (
                  <ul class="capability-list">
                    {contributions.map((item) => (
                      <li>
                        <span><strong>{item.title}</strong><small>{contributionType(item)}</small></span>
                        {item.access && <em>{item.access === "write" ? t.write : t.read}</em>}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            )}

            <section class="detail-panel">
              <h2>{t.security}</h2>
              <dl>
                <div><dt>{t.execution}</dt><dd>{plugin.kind === "theme" ? t.themeStyles : t.sandbox}</dd></div>
                <div>
                  <dt>{t.network}</dt>
                  <dd>
                    {manifest?.networkOrigins.length
                      ? manifest.networkOrigins.join(", ")
                      : t.offline}
                  </dd>
                </div>
                {manifest?.workers && <div><dt>Worker</dt><dd>{t.worker}</dd></div>}
                <div><dt>{t.verification}</dt><dd>{t.checksum}</dd></div>
              </dl>
            </section>

            <section class="detail-panel detail-resources">
              <h2>{t.resources}</h2>
              <a href={repoUrl}>{t.source}<span aria-hidden="true">↗</span></a>
              <a href={releaseUrl}>{t.release}<span aria-hidden="true">↗</span></a>
            </section>
          </aside>
        </div>
      </main>
    ) : (
      <main class="detail-not-found shell">
        <p class="kicker">{t.marketplace}</p>
        <h1>{t.notFound}</h1>
        <p>{t.notFoundBody}</p>
        <a href={listPath}>← {t.back}</a>
      </main>
    )
  }
</Layout>
