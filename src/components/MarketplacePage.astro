---
import type { Locale } from "../i18n";
import { messages, pluginCategoryMessages } from "../i18n";
import Layout from "../layouts/Layout.astro";
import { loadMarketplaceRegistry } from "../lib/marketplace-registry";
import {
  PLUGIN_REGISTRY_REPO,
  pluginVisualVariant,
  type PluginRegistry,
} from "../lib/plugin-registry";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
let registry: PluginRegistry | undefined;

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=3600",
);

try {
  registry = await loadMarketplaceRegistry();
} catch (error) {
  console.error("Could not load the Eidos plugin registry", error);
}

const categoryLabels = pluginCategoryMessages[locale];
const functionalPlugins = registry ? registry.plugins.filter((plugin) => plugin.kind !== "theme") : [];
const themePlugins = registry ? registry.plugins.filter((plugin) => plugin.kind === "theme") : [];
---

<Layout locale={locale} title={t.metaTitle} description={t.metaDescription}>
  <main data-marketplace data-locale={locale}>
    <section class="market-hero" aria-labelledby="market-title">
      <div class="shell">
        <h1 id="market-title">
          <span>{t.titleLead}</span>{locale === "en" && " "}
          <span class="hero-title-accent">{t.titleAccent}</span>
        </h1>

        {
          registry && (
            <>
              <label class="market-search">
                <span class="sr-only">{t.searchLabel}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-4-4" />
                </svg>
                <input
                  type="search"
                  placeholder={t.searchPlaceholder}
                  aria-label={t.searchLabel}
                  autocomplete="off"
                  data-plugin-search
                />
                <span class="market-count" aria-live="polite" data-plugin-count>
                  {t.combinedCount(functionalPlugins.length, themePlugins.length)}
                </span>
              </label>

              <div class="market-tabs-wrapper">
                <div class="market-tabs" role="tablist" aria-label={t.tabsLabel}>
                  <button
                    type="button"
                    role="tab"
                    class="market-tab is-active"
                    data-tab="all"
                    aria-selected="true"
                  >
                    <span>{t.tabAll}</span>
                    <span class="tab-badge">{registry.plugins.length}</span>
                  </button>
                  <button
                    type="button"
                    role="tab"
                    class="market-tab"
                    data-tab="plugins"
                    aria-selected="false"
                  >
                    <span>{t.tabPlugins}</span>
                    <span class="tab-badge">{functionalPlugins.length}</span>
                  </button>
                  <button
                    type="button"
                    role="tab"
                    class="market-tab"
                    data-tab="themes"
                    aria-selected="false"
                  >
                    <span>{t.tabThemes}</span>
                    <span class="tab-badge">{themePlugins.length}</span>
                  </button>
                </div>
              </div>
            </>
          )
        }
      </div>
    </section>

    <section class="catalog" aria-label={t.catalog}>
      <div class="shell catalog-layout">
        {
          !registry ? (
            <div class="catalog-unavailable">
              <div>
                <h3>{t.unavailableTitle}</h3>
                <p>{t.unavailableBody}</p>
              </div>
              <a href={PLUGIN_REGISTRY_REPO}>{t.openRegistry} ↗</a>
            </div>
          ) : (
            <div class="catalog-sections">
              <section class="catalog-section" data-section="plugins" aria-labelledby="heading-plugins">
                <div class="catalog-section-header">
                  <div class="catalog-section-title-row">
                    <h2 id="heading-plugins">{t.pluginsTitle}</h2>
                    <span class="catalog-section-badge" data-count-plugins>{functionalPlugins.length}</span>
                  </div>
                  <p class="catalog-section-desc">{t.pluginsSubtitle}</p>
                </div>
                <ol class="plugin-grid" data-grid-plugins>
                  {functionalPlugins.map((plugin) => {
                    const detailUrl = `${locale === "zh" ? "/zh" : ""}/plugins/${encodeURIComponent(plugin.id)}`;
                    const publisher = plugin.repo.split("/")[0];
                    const searchValue = [
                      plugin.name,
                      plugin.id,
                      plugin.description,
                      plugin.compatibility,
                      plugin.category,
                      categoryLabels[plugin.category],
                      publisher,
                    ]
                      .join(" ")
                      .toLocaleLowerCase();

                    return (
                      <li
                        class="plugin-card"
                        data-plugin-card
                        data-kind="plugin"
                        data-search={searchValue}
                      >
                        <span class={`plugin-icon plugin-icon-${pluginVisualVariant(plugin.id)}`}>
                          {plugin.icon ? (
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                            >
                              {plugin.icon.paths.map((path) => <path d={path} />)}
                            </svg>
                          ) : (
                            <span>{plugin.name.slice(0, 1)}</span>
                          )}
                        </span>
                        <div class="plugin-card-copy">
                          <div class="plugin-title-row">
                            <h3><a href={detailUrl}>{plugin.name}</a></h3>
                            <span class="plugin-category">{categoryLabels[plugin.category]}</span>
                          </div>
                          <p class="plugin-description">{plugin.description}</p>
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </section>

              <section class="catalog-section" data-section="themes" aria-labelledby="heading-themes">
                <div class="catalog-section-header">
                  <div class="catalog-section-title-row">
                    <h2 id="heading-themes">{t.themesTitle}</h2>
                    <span class="catalog-section-badge" data-count-themes>{themePlugins.length}</span>
                  </div>
                  <p class="catalog-section-desc">{t.themesSubtitle}</p>
                </div>
                <ol class="plugin-grid" data-grid-themes>
                  {themePlugins.map((plugin) => {
                    const detailUrl = `${locale === "zh" ? "/zh" : ""}/plugins/${encodeURIComponent(plugin.id)}`;
                    const publisher = plugin.repo.split("/")[0];
                    const searchValue = [
                      plugin.name,
                      plugin.id,
                      plugin.description,
                      plugin.compatibility,
                      plugin.category,
                      categoryLabels[plugin.category],
                      publisher,
                    ]
                      .join(" ")
                      .toLocaleLowerCase();

                    return (
                      <li
                        class="plugin-card"
                        data-plugin-card
                        data-kind="theme"
                        data-search={searchValue}
                      >
                        <span class={`plugin-icon plugin-icon-${pluginVisualVariant(plugin.id)}`}>
                          {plugin.icon ? (
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                            >
                              {plugin.icon.paths.map((path) => <path d={path} />)}
                            </svg>
                          ) : (
                            <span>{plugin.name.slice(0, 1)}</span>
                          )}
                        </span>
                        <div class="plugin-card-copy">
                          <div class="plugin-title-row">
                            <h3><a href={detailUrl}>{plugin.name}</a></h3>
                            <span class="plugin-category">{categoryLabels[plugin.category]}</span>
                          </div>
                          <p class="plugin-description">{plugin.description}</p>
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </section>

              <div class="catalog-empty" data-plugin-empty hidden>
                <h3>{t.noResultsTitle}</h3>
                <p>{t.noResultsBody}</p>
              </div>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<script>
  function setupMarketplace() {
    document.querySelectorAll("[data-marketplace]").forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

      const input = root.querySelector("[data-plugin-search]");
      const count = root.querySelector("[data-plugin-count]");
      const empty = root.querySelector("[data-plugin-empty]");
      const tabButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
      const pluginSection = root.querySelector<HTMLElement>("[data-section='plugins']");
      const themeSection = root.querySelector<HTMLElement>("[data-section='themes']");
      const pluginBadge = root.querySelector<HTMLElement>("[data-count-plugins]");
      const themeBadge = root.querySelector<HTMLElement>("[data-count-themes]");
      const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-plugin-card]"));

      if (!(input instanceof HTMLInputElement) || !(count instanceof HTMLElement)) return;

      const isZh = root.dataset.locale === "zh";

      // Parse initial tab from URL query params or hash
      const urlParams = new URLSearchParams(window.location.search);
      const hash = window.location.hash.replace("#", "");
      let activeTab = urlParams.get("tab") || hash;
      if (activeTab !== "plugins" && activeTab !== "themes") {
        activeTab = "all";
      }

      const formatCount = (plugins: number, themes: number) => {
        if (activeTab === "plugins") {
          return isZh ? `${plugins} 个插件` : `${plugins} ${plugins === 1 ? "plugin" : "plugins"}`;
        }
        if (activeTab === "themes") {
          return isZh ? `${themes} 款主题` : `${themes} ${themes === 1 ? "theme" : "themes"}`;
        }
        if (plugins > 0 && themes > 0) {
          return isZh
            ? `${plugins} 个插件，${themes} 款主题`
            : `${plugins} ${plugins === 1 ? "plugin" : "plugins"}, ${themes} ${themes === 1 ? "theme" : "themes"}`;
        }
        if (plugins > 0) {
          return isZh ? `${plugins} 个插件` : `${plugins} ${plugins === 1 ? "plugin" : "plugins"}`;
        }
        if (themes > 0) {
          return isZh ? `${themes} 款主题` : `${themes} ${themes === 1 ? "theme" : "themes"}`;
        }
        return isZh ? "0 个结果" : "0 results";
      };

      const update = () => {
        const query = input.value.trim().toLocaleLowerCase();
        let visiblePlugins = 0;
        let visibleThemes = 0;

        cards.forEach((card) => {
          const isTheme = card.dataset.kind === "theme";
          const matchesQuery = !query || (card.dataset.search || "").includes(query);
          const matchesTab = activeTab === "all" || (activeTab === "themes" ? isTheme : !isTheme);
          const isVisible = matchesQuery && matchesTab;

          card.hidden = !isVisible;
          if (isVisible) {
            if (isTheme) visibleThemes += 1;
            else visiblePlugins += 1;
          }
        });

        if (pluginSection) {
          pluginSection.hidden = activeTab === "themes" || visiblePlugins === 0;
        }
        if (themeSection) {
          themeSection.hidden = activeTab === "plugins" || visibleThemes === 0;
        }

        if (pluginBadge) {
          pluginBadge.textContent = String(visiblePlugins);
        }
        if (themeBadge) {
          themeBadge.textContent = String(visibleThemes);
        }

        count.textContent = formatCount(visiblePlugins, visibleThemes);

        const totalVisible =
          activeTab === "themes"
            ? visibleThemes
            : activeTab === "plugins"
              ? visiblePlugins
              : visiblePlugins + visibleThemes;

        if (empty instanceof HTMLElement) {
          empty.hidden = totalVisible !== 0;
        }

        tabButtons.forEach((btn) => {
          const isActive = btn.dataset.tab === activeTab;
          btn.classList.toggle("is-active", isActive);
          btn.setAttribute("aria-selected", String(isActive));
        });
      };

      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tab = btn.dataset.tab;
          if (tab && (tab === "all" || tab === "plugins" || tab === "themes")) {
            activeTab = tab;
            const currentUrl = new URL(window.location.href);
            if (activeTab === "all") {
              currentUrl.searchParams.delete("tab");
            } else {
              currentUrl.searchParams.set("tab", activeTab);
            }
            window.history.replaceState({}, "", currentUrl.toString());
            update();
          }
        });
      });

      input.addEventListener("input", update);
      update();
      root.dataset.ready = "true";
    });
  }

  setupMarketplace();
  document.addEventListener("astro:page-load", setupMarketplace);
</script>
