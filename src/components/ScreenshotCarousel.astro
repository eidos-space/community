---
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
  repo: string;
  screenshots: { path: string; alt: string }[];
}
const { locale, repo, screenshots } = Astro.props;
const zh = locale === "zh";
---

<screenshot-carousel
  class="app-screenshots"
  role="region"
  aria-roledescription={zh ? "轮播图" : "carousel"}
  aria-label={zh ? "插件截图" : "Plugin screenshots"}
>
  <div class="screenshot-slides">
    {screenshots.map((screenshot, index) => (
      <figure data-slide hidden={index !== 0} role="group" aria-roledescription={zh ? "幻灯片" : "slide"} aria-label={`${index + 1} / ${screenshots.length}`}>
        <button
          type="button"
          class="screenshot-btn"
          data-screenshot-src={`https://raw.githubusercontent.com/${repo}/main/${screenshot.path}`}
          data-screenshot-alt={screenshot.alt}
          aria-label={`${zh ? "查看完整图片" : "View full image"}: ${screenshot.alt}`}
        >
          <img src={`https://raw.githubusercontent.com/${repo}/main/${screenshot.path}`} alt={screenshot.alt} loading={index === 0 ? "eager" : "lazy"} />
        </button>
        <figcaption>{screenshot.alt}</figcaption>
      </figure>
    ))}
  </div>
  {screenshots.length > 1 && (
    <div class="screenshot-controls">
      <button type="button" data-previous aria-label={zh ? "上一张截图" : "Previous screenshot"}>←</button>
      <div class="screenshot-dots" role="group" aria-label={zh ? "选择截图" : "Choose screenshot"}>
        {screenshots.map((screenshot, index) => (
          <button type="button" data-select={index} aria-pressed={index === 0} aria-label={`${zh ? "截图" : "Screenshot"} ${index + 1}: ${screenshot.alt}`}><span /></button>
        ))}
      </div>
      <span class="screenshot-position" aria-live="polite" aria-atomic="true" data-position>1 / {screenshots.length}</span>
      <button type="button" data-next aria-label={zh ? "下一张截图" : "Next screenshot"}>→</button>
    </div>
  )}
</screenshot-carousel>

<script>
  class ScreenshotCarousel extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === "true") return;
      this.dataset.ready = "true";
      const slides = [...this.querySelectorAll<HTMLElement>("[data-slide]")];
      const selectors = [...this.querySelectorAll<HTMLButtonElement>("[data-select]")];
      const position = this.querySelector<HTMLElement>("[data-position]");
      let current = 0;
      const select = (index: number) => {
        if (!slides.length) return;
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => { slide.hidden = i !== current; });
        selectors.forEach((button, i) => button.setAttribute("aria-pressed", String(i === current)));
        if (position) position.textContent = `${current + 1} / ${slides.length}`;
      };
      this.querySelector("[data-previous]")?.addEventListener("click", () => select(current - 1));
      this.querySelector("[data-next]")?.addEventListener("click", () => select(current + 1));
      selectors.forEach((button, index) => button.addEventListener("click", () => select(index)));
      this.addEventListener("keydown", (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey || slides.length < 2) return;
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === "Home" ? 0 : event.key === "End" ? slides.length - 1 : current + (event.key === "ArrowRight" ? 1 : -1);
        select(next);
        if (event.target instanceof HTMLElement && event.target.matches("[data-select]")) selectors[current]?.focus();
        else if (event.target instanceof HTMLElement && event.target.closest("[data-slide]")) slides[current]?.querySelector<HTMLButtonElement>(".screenshot-btn")?.focus();
      });
    }
  }
  if (!customElements.get("screenshot-carousel")) customElements.define("screenshot-carousel", ScreenshotCarousel);
</script>

<style>
  screenshot-carousel { display: block; }
  [data-slide][hidden] { display: none; }
  .screenshot-controls { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 14px; }
  .screenshot-controls button { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 0; border-radius: 6px; background: transparent; color: var(--ink); cursor: pointer; }
  .screenshot-controls button:hover { background: var(--soft); }
  .screenshot-controls button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .screenshot-dots { display: flex; flex-wrap: wrap; justify-content: center; }
  .screenshot-dots button { width: 28px; }
  .screenshot-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-muted); opacity: 0.4; }
  .screenshot-dots [aria-pressed="true"] span { background: var(--accent); opacity: 1; }
  .screenshot-position { color: var(--ink-muted); font-size: 0.75rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
