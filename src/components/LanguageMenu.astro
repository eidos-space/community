---
import type { Locale } from "../i18n";
import { messages } from "../i18n";

interface Props {
  locale: Locale;
  englishPath: string;
  chinesePath: string;
  placement?: "above" | "below";
}
const { locale, englishPath, chinesePath, placement = "below" } = Astro.props;
const label = messages[locale].language;
---

<details class="language-menu" data-placement={placement}>
  <summary aria-label={label} title={label}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.7 2.5 4 5.5 4 9s-1.3 6.5-4 9M12 3c-2.7 2.5-4 5.5-4 9s1.3 6.5-4 9" />
    </svg>
    <span>{locale === "zh" ? "中文" : "EN"}</span>
    <span class="language-chevron" aria-hidden="true">⌄</span>
  </summary>
  <div class="language-options">
    <a href={englishPath} lang="en" aria-current={locale === "en" ? "page" : undefined}>English</a>
    <a href={chinesePath} lang="zh-CN" aria-current={locale === "zh" ? "page" : undefined}>简体中文</a>
  </div>
</details>

<style>
  .language-menu { position: relative; flex-shrink: 0; font-family: var(--body); }
  .language-menu[data-placement="above"] { justify-self: end; }
  summary { display: flex; min-width: 42px; min-height: 42px; align-items: center; justify-content: center; gap: 6px; padding: 0 8px; border-radius: 8px; color: var(--ink-muted); font-size: 0.78rem; font-weight: 400; line-height: 1.5; letter-spacing: normal; text-transform: none; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, details[open] summary { background: var(--soft); color: var(--ink); }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  summary svg { width: 18px; height: 18px; }
  .language-chevron { margin-top: -5px; font-size: 0.95rem; }
  .language-options { position: absolute; top: calc(100% + 8px); right: 0; z-index: 30; display: grid; min-width: 155px; padding: 6px; border-radius: 10px; background: var(--surface); box-shadow: 0 12px 32px oklch(0.16 0.012 230 / 12%); }
  [data-placement="above"] .language-options { top: auto; bottom: calc(100% + 8px); }
  .language-options a { display: flex; min-height: 36px; align-items: center; padding: 7px 11px; border-radius: 7px; color: var(--ink); font-size: 0.78rem; font-weight: 400; line-height: 1.5; letter-spacing: normal; text-transform: none; white-space: nowrap; }
  .language-options a:hover { background: var(--soft); }
  .language-options a[aria-current="page"] { color: var(--accent); font-weight: 600; }
  @media (max-width: 700px) { .language-menu[data-placement="above"] { justify-self: start; } }
</style>
