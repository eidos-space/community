---
import type { Locale } from "../i18n";
import { messages } from "../i18n";
import EidosMark from "../components/EidosMark.astro";
import Footer from "../components/Footer.astro";
import LanguageMenu from "../components/LanguageMenu.astro";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentSection?: "plugins" | "themes";
}

const { locale, title, description, currentSection: propSection } = Astro.props;
const t = messages[locale];
const pathname = Astro.url.pathname;
const isZh = locale === "zh";

let currentSection = propSection;
if (!currentSection) {
  if (pathname.includes("/themes")) {
    currentSection = "themes";
  } else {
    currentSection = "plugins";
  }
}

const englishPath = isZh ? pathname.replace(/^\/zh(?=\/|$)/, "") || "/" : pathname;
const chinesePath = isZh ? pathname : `/zh${pathname === "/" ? "" : pathname}`;
const docsPath = isZh
  ? "https://docs.eidos.space/zh-cn/plugins/guide/"
  : "https://docs.eidos.space/plugins/guide/";

const pluginsUrl = isZh ? "/zh" : "/";
const themesUrl = isZh ? "/zh/themes" : "/themes";
---

<!doctype html>
<html lang={isZh ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="site-header-brand-group">
          <a class="brand" href={pluginsUrl} aria-label={t.brand}>
            <EidosMark />
            <span>{t.brand}</span>
          </a>
          <nav class="site-header-nav" aria-label="Catalog navigation">
            <a
              href={pluginsUrl}
              class={`site-nav-link ${currentSection === "plugins" ? "is-active" : ""}`}
              aria-current={currentSection === "plugins" ? "page" : undefined}
            >
              {t.tabPlugins}
            </a>
            <a
              href={themesUrl}
              class={`site-nav-link ${currentSection === "themes" ? "is-active" : ""}`}
              aria-current={currentSection === "themes" ? "page" : undefined}
            >
              {t.tabThemes}
            </a>
          </nav>
        </div>
        <nav class="site-header-actions" aria-label="Primary">
          <a href={docsPath}>{t.docs}</a>
          <a href="https://github.com/eidos-space/registry/blob/main/CONTRIBUTING.md">{t.submit}</a>
          <LanguageMenu locale={locale} englishPath={englishPath} chinesePath={chinesePath} />
        </nav>
      </div>
    </header>
    <slot />
    <Footer locale={locale} englishPath={englishPath} chinesePath={chinesePath} />
  </body>
</html>
