---
import type { Locale } from "../i18n";
import { messages } from "../i18n";
import EidosMark from "../components/EidosMark.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentSection?: "all" | "plugins" | "themes";
}

const { locale, title, description, currentSection: propSection } = Astro.props;
const t = messages[locale];
const pathname = Astro.url.pathname;
const isZh = locale === "zh";

let currentSection = propSection;
if (!currentSection) {
  if (pathname.includes("/themes")) {
    currentSection = "themes";
  } else if (pathname.includes("/plugins")) {
    currentSection = "plugins";
  } else {
    currentSection = "all";
  }
}

const englishPath = isZh ? pathname.replace(/^\/zh(?=\/|$)/, "") || "/" : pathname;
const chinesePath = isZh ? pathname : `/zh${pathname}`;
const docsPath = isZh
  ? "https://docs.eidos.space/zh-cn/plugins/guide/"
  : "https://docs.eidos.space/plugins/guide/";

const allUrl = isZh ? "/zh" : "/";
const pluginsUrl = isZh ? "/zh/plugins" : "/plugins";
const themesUrl = isZh ? "/zh/themes" : "/themes";
---

<!doctype html>
<html lang={isZh ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={allUrl} aria-label={t.brand}>
          <EidosMark />
          <span>{t.brand}</span>
        </a>
        <nav class="site-nav" aria-label="Catalog navigation">
          <a
            href={allUrl}
            class={`site-nav-link ${currentSection === "all" ? "is-active" : ""}`}
            aria-current={currentSection === "all" ? "page" : undefined}
          >
            {t.tabAll}
          </a>
          <a
            href={pluginsUrl}
            class={`site-nav-link ${currentSection === "plugins" ? "is-active" : ""}`}
            aria-current={currentSection === "plugins" ? "page" : undefined}
          >
            {t.tabPlugins}
          </a>
          <a
            href={themesUrl}
            class={`site-nav-link ${currentSection === "themes" ? "is-active" : ""}`}
            aria-current={currentSection === "themes" ? "page" : undefined}
          >
            {t.tabThemes}
          </a>
        </nav>
        <nav class="site-header-actions" aria-label="Primary">
          <a href={docsPath}>{t.docs}</a>
          <a href="https://github.com/eidos-space/registry/blob/main/CONTRIBUTING.md">{t.submit}</a>
          <details class="language-menu">
            <summary aria-label={t.language} title={t.language}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.7 2.5 4 5.5 4 9s-1.3 6.5-4 9M12 3c-2.7 2.5-4 5.5-4 9s1.3 6.5-4 9" />
              </svg>
              <span aria-hidden="true">⌄</span>
            </summary>
            <div class="language-options">
              <a href={englishPath} lang="en" aria-current={locale === "en" ? "page" : undefined}>English</a>
              <a href={chinesePath} lang="zh-CN" aria-current={locale === "zh" ? "page" : undefined}>简体中文</a>
            </div>
          </details>
        </nav>
      </div>
    </header>
    <slot />
    <Footer locale={locale} englishPath={englishPath} chinesePath={chinesePath} />
  </body>
</html>
