{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "author", "repo", "screenshot", "modes"],
    "properties": {
      "name": { "type": "string" },
      "author": { "type": "string" },
      "repo": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$"
      },
      "screenshot": { "type": "string" },
      "modes": {
        "type": "array",
        "items": { "enum": ["light", "dark"] },
        "minItems": 1
      },
      "legacy": { "type": "boolean" }
    }
  }
}
